#!/bin/zsh
# claude-stepboard — launch or close a StepBoard stack: ttyd/tmux terminal + FastAPI panel + browser
#   claude-stepboard [use]                  use mode: the built panel served by uvicorn on :800N
#   claude-stepboard dev                    dev mode: Vite HMR on :5172+N, uvicorn --reload on :800N
#   claude-stepboard ls                     what is running
#   claude-stepboard stop [N|all] [--with-claude]
#                                   close session N: servers, Safari tab, tmux viewer sbN;
#                                   claude keeps running in the Claude daemon unless --with-claude
# claude runs as a daemon background session (`claude --bg`); tmux sbN only runs `claude attach`.
cd "${0:A:h}/.." || exit 1    # repo root — :A resolves symlinks, so a PATH symlink works

RUN="${TMPDIR:-/tmp}"; RUN="${RUN%/}"
runfile() { print "$RUN/stepboard-$1.run" }
sockfile() { print "$RUN/stepboard-$1.sock" }
alive() { kill -0 $1 2>/dev/null && [[ $(ps -o command= -p $1) == *claude-s* ]] }

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/stepboard"
idfile() { print "$STATE/claude-$1.id" }
claude_id() { local f=$(idfile $1); [[ -r $f ]] && print -r -- "$(<$f)" }
agents() { AGENTS=$(claude agents --json --all 2>/dev/null) }
bg_status() {  # bg_status <id> → the daemon's status for it, or "gone"; needs $AGENTS
  print -r -- ${AGENTS:-[]} | python3 -c 'import json, sys
i = sys.argv[1]
s = [a for a in json.load(sys.stdin) if a.get("id") == i]
print(s[0].get("status") or "stopped" if s else "gone")' $1
}

ensure_claude() {  # ensure_claude <N> → sets CLAUDE_ID, starting a background session if needed
  local id=$(claude_id $1)
  agents
  if [[ -z $id || $(bg_status $id) == gone ]]; then
    id=$(cd ~ && claude --bg --name "StepBoard $1" 2>&1 | sed $'s/\x1b\\[[0-9;]*m//g' |
         sed -n 's/.*backgrounded · \([0-9a-f]*\).*/\1/p')
    [[ -n $id ]] || { print -u2 "claude-stepboard: could not start a background claude"; return 1 }
    mkdir -p $STATE && print -r -- $id > $(idfile $1)
  fi
  CLAUDE_ID=$id
}

boards() {
  local f n
  for f in $RUN/stepboard-*.run(N); do n=${${f:t:r}#stepboard-}; print $n; done
  for n in ${(f)"$(tmux ls -F '#S' 2>/dev/null)"}; do [[ $n == sb<-> ]] && print ${n#sb}; done
}

list() {
  local n LAUNCHER MODE URLS any=0 f id
  agents
  local slots=(${(nu)$(boards)})
  for f in $STATE/claude-*.id(N); do slots+=${${f:t:r}#claude-}; done
  for n in ${(nu)slots}; do
    any=1
    local board='no board' claude='—'
    if [[ -e $(runfile $n) ]]; then
      source $(runfile $n)
      alive $LAUNCHER && board="$MODE  ${URLS[1]}" || board='stale run file'
    fi
    id=$(claude_id $n)
    if [[ -n $id ]]; then claude="$id ($(bg_status $id), daemon)"
    elif tmux has -t "=sb$n" 2>/dev/null; then claude="inside tmux sb$n"
    fi
    printf '  session %-3s %-34s claude: %s\n' $n $board $claude
  done
  (( any )) || print '  no StepBoard sessions'
}

close_tabs() {
  pgrep -xq Safari || return 0
  local u
  for u in $@; do
    osascript -e "tell application \"Safari\" to close (every tab of every window whose URL starts with \"$u\")" \
      >/dev/null 2>&1
  done
}

stop_one() {  # stop_one <N> <with_claude>
  local n=$1 end=$2 f=$(runfile $1) LAUNCHER MODE URLS KIDS p id=$(claude_id $1)
  if [[ ! -e $f ]] && ! tmux has -t "=sb$n" 2>/dev/null && [[ -z $id ]]; then
    print "  no session $n"; return
  fi
  if [[ -e $f ]]; then
    source $f
    if alive $LAUNCHER; then
      kill -TERM $LAUNCHER
      for _ in {1..60}; do [[ -e $f ]] || break; sleep 0.05; done
    fi
    if [[ -e $f ]]; then
      for p in $KIDS; do kill -KILL $p 2>/dev/null; done
      rm -f $f $(sockfile $n)
    fi
    close_tabs $URLS
  fi
  tmux has -t "=sb$n" 2>/dev/null && tmux kill-session -t "=sb$n"
  if [[ -z $id ]]; then
    print "  session $n closed (its claude ran inside tmux — /resume brings the chat back)"
  elif (( end )); then
    claude stop $id >/dev/null 2>&1
    print "  session $n closed, claude $id stopped (the chat is kept: claude attach $id)"
  else
    print "  session $n closed — claude $id keeps running in the background (claude attach $id)"
  fi
}

usage() {
  cat <<'EOF'
claude-stepboard — the Claude Code CLI in a browser tab, with a prompt panel beside it

usage:
  claude-stepboard [use]                    start a board: built panel on :800N (default)
  claude-stepboard dev                      start a board with hot reload (Vite :5172+N)
  claude-stepboard ls                       list running sessions
  claude-stepboard stop [N|all] [--with-claude]
                                            close session N: servers, Safari tab, tmux viewer;
                                            claude keeps running in the Claude daemon
                                              --with-claude  stop that claude too (chat kept)
                                              no N           only when exactly one board is up
  claude-stepboard man                      the full manual
  claude-stepboard -h | --help | help       this summary

A second launch asks "create session N? [Y/n]" — Enter means yes.
claude runs as a background session in the Claude daemon, one per board slot;
the board only views it (`claude attach`). Ctrl-C here closes the board, and
the next launch — or `claude attach <id>` anywhere — picks claude up again.

in the panel:  ⌘J terminal · ⌘K composer · ⌘⇧L grab · ⌥1–9 prompts · ⌃⇧Q close
EOF
}

case $1 in
  -h|--help|help) usage; exit 0 ;;
  man) exec man ./man/claude-stepboard.1 ;;
  ls) list; exit 0 ;;
esac

if [[ $1 == stop ]]; then
  shift
  local end=0 which=
  for a in $@; do [[ $a == --with-claude ]] && end=1 || which=$a; done
  local all=(${(nu)$(boards)})
  local f; for f in $STATE/claude-*.id(N); do (( end )) && all+=${${f:t:r}#claude-}; done
  all=(${(nu)all})
  (( ${#all} )) || { print '  nothing to stop'; exit 0 }
  if [[ -z $which ]]; then
    local mine=() f
    for f in $RUN/stepboard-*.run(N); do source $f; alive $LAUNCHER && mine+=${${f:t:r}#stepboard-}; done
    (( ${#mine} == 1 )) || { print 'say which session: claude-stepboard stop <N|all>'; list; exit 2 }
    which=$mine[1]
  fi
  [[ $which == all ]] && targets=($all) || targets=($which)
  for n in $targets; do
    [[ $n == <-> ]] || { print "not a session number: $n"; exit 2 }
    stop_one $n $end
  done
  exit 0
fi

MODE=${1:-use}
[[ $MODE == (use|dev) ]] || { print -u2 "claude-stepboard: unknown command '$MODE'\n"; usage >&2; exit 2 }

N=1
while lsof -nP -iTCP:$((8000+N)) -sTCP:LISTEN >/dev/null 2>&1; do
  ((N++))                            # 8001 busy → try 8002, 8003, ...
done

if (( N > 1 )); then
  read -r "REPLY?session(s) 1..$((N-1)) already running — create session $N? [Y/n] "
  [[ -z $REPLY || $REPLY == [yY]* ]] || exit 0
fi

WEB_PORT=$((8000+N))
VITE_PORT=$((5172+N))                # session 1 → 5173, session 2 → 5174, ...
SESSION="sb$N"
SOCK=$(sockfile $N)
RUNFILE=$(runfile $N)
[[ $MODE == dev ]] && OPEN=http://localhost:$VITE_PORT || OPEN=http://localhost:$WEB_PORT

# Every child's output goes through tag(): one colored `label │` per line, so the
# interleaved streams stay attributable at a glance. fflush() keeps it live —
# macOS ships no stdbuf and its sed has no -u. Per-stream sub() drops
# boilerplate the label already conveys — ttyd's [timestamp] and its N: notice
# marker, uvicorn's INFO: — while W:/E:/WARNING:/ERROR: stay. The product URL is
# a solid block (bold black on bright green) wherever it shows.
URL=$'\033[1;30;102m'; RESET=$'\033[0m'
tag() {  # tag <label> <ansi-color-code>
  awk -v l="$1" -v c="$2" -v u="$URL" -v r="$RESET" '{
    if (l == "ttyd") { sub(/^\[[0-9\/: ]+\] /, ""); sub(/^N: /, "") }
    if (l == "api")  sub(/^INFO: */, "")
    if (l == "vite" && match($0, /http:\/\/localhost:[0-9]+\/?/))
      $0 = substr($0, 1, RSTART-1) u " " substr($0, RSTART, RLENGTH) " " r substr($0, RSTART+RLENGTH)
    printf "\033[1;%sm%4s │\033[0m %s\n", c, l, $0; fflush()
  }'
}

print -P "%F{8}── stepboard $N ($MODE) ── term $SOCK · api :$WEB_PORT · ui ${URL} $OPEN ${RESET}%F{8} ──%f"

if [[ $MODE == use ]]; then
  if [[ ! -e ui/dist/index.html || -n $(find ui/src ui/public ui/index.html ui/vite.config.js \
        ui/package-lock.json -newer ui/dist/index.html -print -quit) ]]; then
    ui/node_modules/.bin/vite build ui --logLevel warn > >(tag vite 35) 2>&1 ||
      print "build failed — serving the last good ui/dist"
  fi
fi

KIDS=()
CLEANED=0
cleanup() {
  (( CLEANED++ )) && return
  trap - INT TERM EXIT
  local p
  for p in $KIDS; do kill -TERM $p 2>/dev/null; done
  for _ in {1..40}; do
    local left=0
    for p in $KIDS; do kill -0 $p 2>/dev/null && left=1; done
    (( left )) || break
    sleep 0.05
  done
  for p in $KIDS; do kill -KILL $p 2>/dev/null; done
  tmux has -t "=$SESSION" 2>/dev/null && tmux kill-session -t "=$SESSION"
  rm -f $RUNFILE $SOCK
  print -P "\n%F{8}── stepboard $N closed · claude $CLAUDE_ID keeps running in the background ──%f"
  exit 0
}
trap cleanup INT TERM EXIT

ensure_claude $N || exit 1
print -P "%F{8}── claude: background session $CLAUDE_ID (StepBoard $N) ──%f"
CLAUDE=(claude attach $CLAUDE_ID)
tmux has -t "=$SESSION" 2>/dev/null || tmux new -d -s "$SESSION" -c ~ $CLAUDE
rm -f $SOCK
ttyd -W -i $SOCK -s KILL tmux new -A -s "$SESSION" -c ~ $CLAUDE \
  \; set status-style 'bg=#0a0a0c,fg=#9f9fa9' \
  \; set set-titles on \; set set-titles-string '#T · #S' > >(tag ttyd 36) 2>&1 &
KIDS+=$!

API_ENV=(SB_SESSION=$SESSION SB_TTYD_SOCK=$SOCK PYTHONUNBUFFERED=1)
if [[ $MODE == dev ]]; then
  EXCLUDE=()
  for d in .venv .claude ui node_modules; do [[ -d $d ]] && EXCLUDE+=(--reload-exclude "$PWD/$d"); done
  env $API_ENV uv run uvicorn serve:app --port $WEB_PORT --reload $EXCLUDE > >(tag api 32) 2>&1 &
  KIDS+=$!
  SB_PORT=$WEB_PORT ui/node_modules/.bin/vite ui --port $VITE_PORT --strictPort > >(tag vite 35) 2>&1 &
  KIDS+=$!
else
  env $API_ENV uv run uvicorn serve:app --port $WEB_PORT > >(tag api 32) 2>&1 &
  KIDS+=$!
fi

print -rl -- "LAUNCHER=$$" "MODE=$MODE" \
  "URLS=(http://localhost:$WEB_PORT http://localhost:$VITE_PORT)" "KIDS=($KIDS)" > $RUNFILE

up() {
  curl -sf -o /dev/null -m 1 http://127.0.0.1:$WEB_PORT/api/config || return 1
  [[ $MODE == use ]] || curl -sf -o /dev/null -m 1 $OPEN/
}
for _ in {1..200}; do up && break; sleep 0.05; done

printf '\n%s  ▶  OPEN  %s  %s\n\n' "$URL" "$OPEN" "$RESET"
open -a Safari $OPEN                 # localhost, not 127.0.0.1 — vite may bind IPv6 only
wait   # keep the launcher in the foreground; Ctrl-C or `claude-stepboard stop` runs cleanup

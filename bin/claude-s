#!/bin/zsh
# claude-s — launch a StepBoard stack: ttyd/tmux terminal + FastAPI panel + browser
# Runs session 1 by default; if it's already up, offers to start session 2, 3, ...
# Everything hot-reloads: uvicorn --reload watches serve.py, Vite HMRs ui/src.
cd "${0:A:h}/.." || exit 1    # repo root — :A resolves symlinks, so a PATH symlink works

N=1
while lsof -nP -iTCP:$((7680+N)) -sTCP:LISTEN >/dev/null 2>&1; do
  ((N++))                            # 7681 busy → try 7682, 7683, ...
done

if (( N > 1 )); then
  read -q "?session(s) 1..$((N-1)) already running — create session $N? [y/n] " || { echo; exit 0 }
  echo
fi

TTYD_PORT=$((7680+N))
WEB_PORT=$((8000+N))
SESSION="sb$N"

VITE_PORT=$((5172+N))                # session 1 → 5173, session 2 → 5174, ...

# The panel's branch view has to read THIS pane's transcript, and sessions that
# share a working directory also share a project folder — so "newest file wins"
# picks the wrong one whenever two are up. Assign the id here instead and give
# the same value to both sides. Lowercase: claude wants a canonical UUID.
CLAUDE_SESSION=$(uuidgen | tr 'A-Z' 'a-z')

# Every child pipes through tag(): one colored `label │` per line, so the three
# interleaved streams stay attributable at a glance. fflush() keeps it live —
# macOS ships no stdbuf and its sed has no -u. Child ANSI colors don't survive
# a pipe anyway (not a TTY), so the label carries the color instead. Per-stream
# sub() drops boilerplate the label already conveys — ttyd's [timestamp] and
# its N: notice marker, uvicorn's INFO: — while W:/E:/WARNING:/ERROR: stay.
tag() {  # tag <label> <ansi-color-code>
  awk -v l="$1" -v c="$2" '{
    if (l == "ttyd") { sub(/^\[[0-9\/: ]+\] /, ""); sub(/^N: /, "") }
    if (l == "api")  sub(/^INFO: */, "")
    printf "\033[1;%sm%4s │\033[0m %s\n", c, l, $0; fflush()
  }'
}

print -P "%F{8}── stepboard $N ── term :$TTYD_PORT · api :$WEB_PORT · ui http://localhost:$VITE_PORT ──%f"

ttyd -W -i lo0 -p $TTYD_PORT \
  tmux new -A -s $SESSION claude --session-id $CLAUDE_SESSION 2>&1 | tag ttyd 36 &
# PYTHONUNBUFFERED: print() into a pipe block-buffers, which would hold back
# serve.py's POST /send lines for minutes; force line-by-line delivery.
SB_SESSION=$SESSION SB_TTYD_PORT=$TTYD_PORT SB_CLAUDE_SESSION=$CLAUDE_SESSION PYTHONUNBUFFERED=1 \
  uv run uvicorn serve:app --port $WEB_PORT --reload 2>&1 | tag api 32 &
(cd ui && SB_PORT=$WEB_PORT npm run dev -- --port $VITE_PORT --strictPort 2>&1 | tag vite 35) &
sleep 1 && open http://localhost:$VITE_PORT   # localhost, not 127.0.0.1 — vite may bind IPv6 only
wait   # keep script in foreground; Ctrl-C kills this session's ttyd + uvicorn + vite together

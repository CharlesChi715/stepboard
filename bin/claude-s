#!/bin/zsh
# claude-s — launch a StepBoard stack: ttyd/tmux terminal + FastAPI panel + browser
# Runs session 1 by default; if it's already up, offers to start session 2, 3, ...
cd "$(dirname "$0")/.." || exit 1    # repo root, wherever this clone lives

N=1
while lsof -nP -iTCP:$((7680+N)) -sTCP:LISTEN >/dev/null 2>&1; do
  ((N++))                            # 7681 busy → try 7682, 7683, ...
done

if (( N > 1 )); then
  read -q "?session(s) 1..$((N-1)) already running — create session $N? [y/n] " || { echo; exit 0 }
  echo
fi

TTYD_PORT=$((7680+N))
WEB_PORT=$((8000+N))
SESSION="sb$N"

ttyd -W -i lo0 -p $TTYD_PORT tmux new -A -s $SESSION claude &
SB_SESSION=$SESSION SB_TTYD_PORT=$TTYD_PORT uv run uvicorn serve:app --port $WEB_PORT &
sleep 1 && open http://127.0.0.1:$WEB_PORT
wait   # keep script in foreground; Ctrl-C kills this session's ttyd + uvicorn together

#!/bin/zsh
# claude-s — launch a StepBoard stack: ttyd/tmux terminal + FastAPI panel + browser
#   claude-s        use mode: the built panel served by uvicorn on :800N — no Node, no reloader
#   claude-s dev    dev mode: Vite HMR on :5172+N, uvicorn --reload on :800N
# Runs session 1 by default; if it's already up, offers to start session 2, 3, ...
cd "${0:A:h}/.." || exit 1    # repo root — :A resolves symlinks, so a PATH symlink works

MODE=${1:-use}
[[ $MODE == (use|dev) ]] || { print "usage: claude-s [use|dev]"; exit 2 }

N=1
while lsof -nP -iTCP:$((8000+N)) -sTCP:LISTEN >/dev/null 2>&1; do
  ((N++))                            # 8001 busy → try 8002, 8003, ...
done

if (( N > 1 )); then
  read -q "?session(s) 1..$((N-1)) already running — create session $N? [y/n] " || { echo; exit 0 }
  echo
fi

WEB_PORT=$((8000+N))
VITE_PORT=$((5172+N))                # session 1 → 5173, session 2 → 5174, ...
SESSION="sb$N"
SOCK="${TMPDIR:-/tmp}"; SOCK="${SOCK%/}/stepboard-$N.sock"
[[ $MODE == dev ]] && OPEN=http://localhost:$VITE_PORT || OPEN=http://localhost:$WEB_PORT

# Every child pipes through tag(): one colored `label │` per line, so the
# interleaved streams stay attributable at a glance. fflush() keeps it live —
# macOS ships no stdbuf and its sed has no -u. Per-stream sub() drops
# boilerplate the label already conveys — ttyd's [timestamp] and its N: notice
# marker, uvicorn's INFO: — while W:/E:/WARNING:/ERROR: stay. The product URL is
# a solid block (bold black on bright green) wherever it shows.
URL=$'\033[1;30;102m'; RESET=$'\033[0m'
tag() {  # tag <label> <ansi-color-code>
  awk -v l="$1" -v c="$2" -v u="$URL" -v r="$RESET" '{
    if (l == "ttyd") { sub(/^\[[0-9\/: ]+\] /, ""); sub(/^N: /, "") }
    if (l == "api")  sub(/^INFO: */, "")
    if (l == "vite" && match($0, /http:\/\/localhost:[0-9]+\/?/))
      $0 = substr($0, 1, RSTART-1) u " " substr($0, RSTART, RLENGTH) " " r substr($0, RSTART+RLENGTH)
    printf "\033[1;%sm%4s │\033[0m %s\n", c, l, $0; fflush()
  }'
}

print -P "%F{8}── stepboard $N ($MODE) ── term $SOCK · api :$WEB_PORT · ui ${URL} $OPEN ${RESET}%F{8} ──%f"

if [[ $MODE == use ]]; then
  if [[ ! -e ui/dist/index.html || -n $(find ui/src ui/public ui/index.html ui/vite.config.js \
        ui/package-lock.json -newer ui/dist/index.html -print -quit) ]]; then
    (cd ui && ./node_modules/.bin/vite build --logLevel warn 2>&1 | tag vite 35) ||
      print "build failed — serving the last good ui/dist"
  fi
fi

CLAUDE=(claude --settings '{"preferredNotifChannel":"terminal_bell"}')
tmux has -t "=$SESSION" 2>/dev/null || tmux new -d -s "$SESSION" -c ~ $CLAUDE
rm -f "$SOCK"
ttyd -W -i "$SOCK" -s KILL tmux new -A -s "$SESSION" -c ~ $CLAUDE \
  \; set status-style 'bg=#0a0a0c,fg=#9f9fa9' \
  \; set set-titles on \; set set-titles-string '#T · #S' 2>&1 | tag ttyd 36 &

API_ENV=(SB_SESSION=$SESSION SB_TTYD_SOCK=$SOCK PYTHONUNBUFFERED=1)
if [[ $MODE == dev ]]; then
  env $API_ENV uv run uvicorn serve:app --port $WEB_PORT --reload \
    --reload-exclude "$PWD/.venv" --reload-exclude "$PWD/.claude" \
    --reload-exclude "$PWD/ui" --reload-exclude "$PWD/node_modules" 2>&1 | tag api 32 &
  (cd ui && SB_PORT=$WEB_PORT ./node_modules/.bin/vite --port $VITE_PORT --strictPort 2>&1 | tag vite 35) &
else
  env $API_ENV uv run uvicorn serve:app --port $WEB_PORT 2>&1 | tag api 32 &
fi

up() {
  curl -sf -o /dev/null -m 1 http://127.0.0.1:$WEB_PORT/api/config || return 1
  [[ $MODE == use ]] || curl -sf -o /dev/null -m 1 $OPEN/
}
for _ in {1..200}; do up && break; sleep 0.05; done

printf '\n%s  ▶  OPEN  %s  %s\n\n' "$URL" "$OPEN" "$RESET"
open -a Safari $OPEN                 # localhost, not 127.0.0.1 — vite may bind IPv6 only
wait   # keep script in foreground; Ctrl-C kills this session's ttyd + uvicorn (+ vite) together
